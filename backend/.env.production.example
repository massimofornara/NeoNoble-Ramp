# NeoNoble execution safety — production defaults are deliberately LOCKED.
NN_REAL_EXECUTION_ENABLED=false
NN_LIVE_TRADING_ENABLED=false
NN_INSTANT_WITHDRAW_ENABLED=false
NN_AUTOMATION_ENABLED=false
NN_AUTONOMOUS_EXECUTION_ENABLED=false

# UniCredit TPP gate
UNICREDIT_ENVIRONMENT=sandbox
TPP_REGULATORY_STATUS=NOT_VERIFIED
TPP_PISP_ENABLED=false
TPP_AISP_ENABLED=false
